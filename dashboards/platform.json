{
  "uid": "diddi-platform",
  "title": "DIDDI · Plateforme",
  "tags": [
    "diddi",
    "observability-v1"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(diddi_observe_service_info, environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(diddi_observe_service_info{environment=~\"$environment\"}, service_name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Couverture réelle",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "Les services inventoriés ne sont pas nécessairement raccordés. **Aucune donnée ≠ zéro erreur.** La conformité est déclarée avec preuves dans le registre. Les noms de service et environnements servent de filtres communs."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Services recensés",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(diddi_observe_service_info{service_name=~\"$service\",environment=~\"$environment\"})",
          "query": "count(diddi_observe_service_info{service_name=~\"$service\",environment=~\"$environment\"})",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Registre de conformité",
