{
  "uid": "diddi-workers",
  "title": "DIDDI · Workers et files",
  "tags": [
    "diddi",
    "observability-v1"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(diddi_observe_service_info, environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(diddi_observe_service_info{environment=~\"$environment\"}, service_name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Âge du heartbeat",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - diddi_worker_heartbeat_timestamp_seconds{service_name=~\"$service\",environment=~\"$environment\"}",
          "query": "time() - diddi_worker_heartbeat_timestamp_seconds{service_name=~\"$service\",environment=~\"$environment\"}",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Messages en attente",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "diddi_queue_pending{service_name=~\"$service\",environment=~\"$environment\"}",
          "query": "diddi_queue_pending{service_name=~\"$service\",environment=~\"$environment\"}",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Âge du plus ancien message",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "diddi_queue_oldest_age_seconds{service_name=~\"$service\",environment=~\"$environment\"}",
          "query": "diddi_queue_oldest_age_seconds{service_name=~\"$service\",environment=~\"$environment\"}",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Dead letters",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "diddi_queue_dead_letter{service_name=~\"$service\",environment=~\"$environment\"}",
          "query": "diddi_queue_dead_letter{service_name=~\"$service\",environment=~\"$environment\"}",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Résultats des jobs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,job_type,outcome) (rate(diddi_jobs_total{service_name=~\"$service\",environment=~\"$environment\"}[5m]))",
          "query": "sum by (service_name,job_type,outcome) (rate(diddi_jobs_total{service_name=~\"$service\",environment=~\"$environment\"}[5m]))",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Tâches planifiées",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "Le seuil de fraîcheur dépend de la cadence. Ne pas appliquer le seuil des workers continus aux jobs quotidiens. Seuils métier à enregistrer avant activation."
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      }
    }
  ],
  "links": [
    {
      "title": "DIDDI dashboards",
      "type": "dashboards",
      "tags": [
        "diddi"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ]
}
