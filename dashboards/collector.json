        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Pertes déclarées par les services",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,signal,reason) (rate(diddi_telemetry_dropped_total[5m]))",
          "query": "sum by (service_name,signal,reason) (rate(diddi_telemetry_dropped_total[5m]))",
