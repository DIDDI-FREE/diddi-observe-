        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Échantillons par cible",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_samples_scraped",
          "query": "scrape_samples_scraped",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
