{
  "uid": "diddi-service",
  "title": "DIDDI · Service",
  "tags": [
    "diddi",
    "observability-v1"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(diddi_observe_service_info, environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(diddi_observe_service_info{environment=~\"$environment\"}, service_name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Débit par route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,route) (rate(diddi_http_server_requests_total{service_name=~\"$service\",environment=~\"$environment\"}[5m]))",
          "query": "sum by (service_name,route) (rate(diddi_http_server_requests_total{service_name=~\"$service\",environment=~\"$environment\"}[5m]))",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Taux de 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(diddi_http_server_requests_total{service_name=~\"$service\",environment=~\"$environment\",status_code=~\"5..\"}[5m])) / sum by (service_name) (rate(diddi_http_server_requests_total{service_name=~\"$service\",environment=~\"$environment\"}[5m]))",
          "query": "sum by (service_name) (rate(diddi_http_server_requests_total{service_name=~\"$service\",environment=~\"$environment\",status_code=~\"5..\"}[5m])) / sum by (service_name) (rate(diddi_http_server_requests_total{service_name=~\"$service\",environment=~\"$environment\"}[5m]))",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "p95 par route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,service_name,route) (rate(diddi_http_server_request_duration_seconds_bucket{service_name=~\"$service\",environment=~\"$environment\"}[5m])))",
          "query": "histogram_quantile(0.95,sum by (le,service_name,route) (rate(diddi_http_server_request_duration_seconds_bucket{service_name=~\"$service\",environment=~\"$environment\"}[5m])))",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Dépendances",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,dependency,outcome) (rate(diddi_dependency_requests_total{service_name=~\"$service\",environment=~\"$environment\"}[5m]))",
          "query": "sum by (service_name,dependency,outcome) (rate(diddi_dependency_requests_total{service_name=~\"$service\",environment=~\"$environment\"}[5m]))",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Scrape applicatif",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{service_name=~\"$service\",environment=~\"$environment\",job=~\"service-.*\"}",
          "query": "up{service_name=~\"$service\",environment=~\"$environment\",job=~\"service-.*\"}",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "SLO",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "SLO non défini tant que le propriétaire du service ne l’a pas enregistré. Les compteurs de durée legacy permettent une moyenne, pas un p95."
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      }
    }
  ],
  "links": [
    {
      "title": "DIDDI dashboards",
      "type": "dashboards",
      "tags": [
        "diddi"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ]
}
