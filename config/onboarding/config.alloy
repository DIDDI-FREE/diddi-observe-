logging {
  level = "info"
  format = "json"
}

otelcol.processor.memory_limiter "bounded" {
  check_interval = "1s"
  limit = "384MiB"
  spike_limit = "96MiB"
  output {
    traces = [otelcol.processor.batch.central.input]
    logs = [otelcol.processor.batch.central.input]
  }
}
otelcol.processor.batch "central" {
  timeout = "5s"
  send_batch_size = 512
  send_batch_max_size = 1024
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
    logs = [otelcol.exporter.otlphttp.loki.input]
  }
}
otelcol.storage.file "queue" { directory = "/var/lib/alloy/queue" }
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
  sending_queue {
    enabled = true
    queue_size = 1024
    storage = otelcol.storage.file.queue.handler
  }
  retry_on_failure { max_elapsed_time = "300s" }
}
otelcol.exporter.otlphttp "loki" {
  client { endpoint = "http://loki:3100/otlp" }
  sending_queue {
    enabled = true
    queue_size = 1024
    storage = otelcol.storage.file.queue.handler
  }
  retry_on_failure { max_elapsed_time = "300s" }
}
loki.write "central" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}


otelcol.receiver.otlp "diddifree_id" {
  http { endpoint = "0.0.0.0:4400" }
  output {
    traces = [otelcol.processor.transform.diddifree_id.input]
    logs = [otelcol.processor.transform.diddifree_id.input]
  }
}
otelcol.processor.transform "diddifree_id" {
  error_mode = "propagate"
  trace_statements {
    context = "resource"
    statements = ["set(attributes[\"service.namespace\"], \"diddi\")",
      "set(attributes[\"service.name\"], \"diddifree-id\")",
      "set(attributes[\"deployment.environment.name\"], \"staging\")",
      "set(attributes[\"diddi.deployment.id\"], \"diddifree-id-staging\")",
      "set(attributes[\"diddi.component\"], \"api\") where attributes[\"diddi.component\"] != \"api\" and attributes[\"diddi.component\"] != \"worker\" and attributes[\"diddi.component\"] != \"scheduler\" and attributes[\"diddi.component\"] != \"collector\" and attributes[\"diddi.component\"] != \"web\""]
  }
  log_statements {
    context = "resource"
    statements = ["set(attributes[\"service.namespace\"], \"diddi\")",
      "set(attributes[\"service.name\"], \"diddifree-id\")",
      "set(attributes[\"deployment.environment.name\"], \"staging\")",
      "set(attributes[\"diddi.deployment.id\"], \"diddifree-id-staging\")",
      "set(attributes[\"diddi.component\"], \"api\") where attributes[\"diddi.component\"] != \"api\" and attributes[\"diddi.component\"] != \"worker\" and attributes[\"diddi.component\"] != \"scheduler\" and attributes[\"diddi.component\"] != \"collector\" and attributes[\"diddi.component\"] != \"web\""]
  }
  trace_statements {
    context = "span"
    statements = [
      "delete_matching_keys(attributes, \"(?i).*?(authorization|password|secret|token|cookie|email|phone|url.full|db.statement).*\")",
    ]
  }
  log_statements {
    context = "log"
    statements = [
      "delete_matching_keys(attributes, \"(?i).*?(authorization|password|secret|token|cookie|email|phone).*\")",
    ]
  }
  output {
    traces = [otelcol.processor.memory_limiter.bounded.input]
    logs = [otelcol.processor.memory_limiter.bounded.input]
  }
}


local.file_match "diddifree_id_api" {
  path_targets = [{__path__ = "/var/log/diddifree/observability-api.jsonl"}]
}
loki.source.file "diddifree_id_api" {
  targets = local.file_match.diddifree_id_api.targets
  forward_to = [loki.process.diddifree_id_api.receiver]
}
loki.process "diddifree_id_api" {
  stage.json {
    expressions = { timestamp = "timestamp || ts || at", level = "level", trace_id = "trace_id" }
    drop_malformed = true
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
    action_on_failure = "skip"
  }
  stage.replace {
    expression = `(?i)"(?:password|secret|token|authorization|cookie|pin)"\s*:\s*"([^"\\]*(?:\\.[^"\\]*)*)"`
    replace = "[REDACTED]"
  }
  stage.static_labels { values = {"service_name" = "diddifree-id", "environment" = "staging", "deployment_id" = "diddifree-id-staging", "component" = "api"} }
  stage.label_drop { values = ["filename"] }
  forward_to = [loki.write.central.receiver]
}


local.file_match "diddifree_id_worker" {
  path_targets = [{__path__ = "/var/log/diddifree/observability-worker.jsonl"}]
}
loki.source.file "diddifree_id_worker" {
