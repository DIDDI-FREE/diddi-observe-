local.file_match "synthetic" {
  path_targets = [{__path__ = "/var/log/inputs/synthetic/*.log"}]
}
loki.source.file "synthetic" {
  targets = local.file_match.synthetic.targets
  forward_to = [loki.process.synthetic.receiver]
}
loki.process "synthetic" {
  stage.json {
    expressions = { timestamp = "timestamp || ts || at", level = "level", trace_id = "trace_id" }
    drop_malformed = true
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
    action_on_failure = "skip"
  }
  stage.replace {
    expression = `(?i)"(?:password|secret|token|authorization|cookie|otp|pin)"\s*:\s*"([^"\\]*(?:\\.[^"\\]*)*)"`
    replace = "[REDACTED]"
  }
  stage.static_labels { values = {"service_name" = "synthetic", "environment" = "test", "deployment_id" = "observe-pilot", "component" = "api"} }
  stage.label_drop { values = ["filename"] }
  forward_to = [loki.write.central.receiver]
}


